-- ==================== 5. ADVANCED ESP ====================
local espBtn = Btn("ESP (ชื่อ/เลือด): ปิด")

local function removeESP(plr)
	pcall(function()
		if EspDrawings[plr] then
			if EspDrawings[plr].Billboard then EspDrawings[plr].Billboard:Destroy() end
			EspDrawings[plr] = nil
		end
	end)
end

local function addESP(plr)
	if plr == LocalPlayer then return end
	pcall(function()
		local function setup(char)
			removeESP(plr)
			local head = char:WaitForChild("Head", 3)
			local hum = char:WaitForChild("Humanoid", 3)
			local root = char:WaitForChild("HumanoidRootPart", 3)
			if not head or not hum or not root then return end

			local hl = Instance.new("Highlight")
			hl.Name = "CatESP_HL"
			hl.FillColor = Color3.fromRGB(0, 170, 255)
			hl.OutlineColor = Color3.fromRGB(255, 255, 255)
			hl.FillTransparency = 0.5
			hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			hl.Parent = char

			local bg = Instance.new("BillboardGui")
			bg.Name = "CatESP_UI"
			bg.Size = UDim2.new(0, 150, 0, 50)
			bg.StudsOffset = Vector3.new(0, 2.5, 0)
			bg.AlwaysOnTop = true
			bg.Parent = char

			local txtLabel = Instance.new("TextLabel")
			txtLabel.Size = UDim2.new(1, 0, 1, 0)
			txtLabel.BackgroundTransparency = 1
			txtLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
			txtLabel.TextStrokeTransparency = 0
			txtLabel.Font = Enum.Font.GothamBold
			txtLabel.TextSize = 11
			txtLabel.Parent = bg

			EspDrawings[plr] = { Billboard = bg }

			local conn
			conn = RunService.RenderStepped:Connect(function()
				if not State.ESP or not char or not char.Parent or hum.Health <= 0 then
					bg.Enabled = false
					hl.Enabled = false
					if not State.ESP then conn:Disconnect() end
					return
				end
				bg.Enabled = true
				hl.Enabled = true

				local myRoot = Root()
				local dist = myRoot and math.floor((myRoot.Position - root.Position).Magnitude) or 0
				local hp = math.floor(hum.Health)
				local maxHp = math.floor(hum.MaxHealth)

				txtLabel.Text = string.format("%s\n❤️ %d/%d | 📏 %dm", plr.DisplayName, hp, maxHp, dist)
			end)
		end
		if plr.Character then setup(plr.Character) end
		plr.CharacterAdded:Connect(setup)
		plr.CharacterRemoving:Connect(function() removeESP(plr) end)
	end)
end

espBtn.MouseButton1Click:Connect(function()
	State.ESP = not State.ESP
	espBtn.Text = State.ESP and "ESP (ชื่อ/เลือด): เปิด" or "ESP (ชื่อ/เลือด): ปิด"
	espBtn.BackgroundColor3 = State.ESP and Color3.fromRGB(25, 130, 190) or Color3.fromRGB(34, 34, 44)

	if State.ESP then
		for _, p in ipairs(Players:GetPlayers()) do addESP(p) end
		Dis("ESPAdd")
		Conn["ESPAdd"] = Players.PlayerAdded:Connect(addESP)
		Dis("ESPRemove")
		Conn["ESPRemove"] = Players.PlayerRemoving:Connect(removeESP)
	else
		Dis("ESPAdd")
		Dis("ESPRemove")
		for _, p in ipairs(Players:GetPlayers()) do removeESP(p) end
	end
end)

