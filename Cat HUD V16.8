-- ==================== 1. FLY ====================
local function StopFly()
	State.Fly = false
	Dis("Fly")
	pcall(function()
		if BV then BV:Destroy() BV = nil end
		if BG then BG:Destroy() BG = nil end
		local h = Hum()
		if h then h.PlatformStand = false end
	end)
end

local function StartFly()
	StopFly()
	pcall(function()
		local r, h = Root(), Hum()
		if not r or not h then return end
		State.Fly = true
		h.PlatformStand = true
		
		BV = Instance.new("BodyVelocity")
		BV.MaxForce = Vector3.new(1e9, 1e9, 1e9)
		BV.Velocity = Vector3.zero
		BV.Parent = r

		BG = Instance.new("BodyGyro")
		BG.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
		BG.P = 2000
		BG.Parent = r

		Conn["Fly"] = RunService.RenderStepped:Connect(function()
			if not State.Fly then return end
			pcall(function()
				local rr, hh = Root(), Hum()
				if not rr or not hh then StopFly() return end
				local move = Vector3.zero
				local dir = hh.MoveDirection
				if dir.Magnitude > 0 then
					local rel = Camera.CFrame:VectorToObjectSpace(dir)
					move = Camera.CFrame.LookVector * -rel.Z + Camera.CFrame.RightVector * rel.X
				end
				if UIS:IsKeyDown(Enum.KeyCode.Space) then move += Vector3.yAxis end
				if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then move -= Vector3.yAxis end
				BV.Velocity = move.Magnitude > 0 and move.Unit * State.FlySpeed or Vector3.zero
				BG.CFrame = Camera.CFrame
			end)
		end)
	end)
end

local flyBtn = Btn("บิน: ปิด")
