	local Page = Instance.new("ScrollingFrame", ContentContainer)
	Page.Size = UDim2.new(1, -8, 1, -8)
	Page.Position = UDim2.fromOffset(4, 4)
	Page.BackgroundTransparency = 1
	Page.Visible = false
	Page.CanvasSize = UDim2.new(0, 0, 0, 0)
	Page.ScrollBarThickness = 3

	local PageLayout = Instance.new("UIListLayout", Page)
	PageLayout.Padding = UDim.new(0, 5)
	PageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		Page.CanvasSize = UDim2.new(0, 0, 0, PageLayout.AbsoluteContentSize.Y + 10)
	end)

	table.insert(tabs, TabButton)
	table.insert(pages, Page)
	local index = #tabs

	TabButton.MouseButton1Click:Connect(function()
		for i, btn in ipairs(tabs) do
			btn.BackgroundColor3 = (i == index) and Color3.fromRGB(80, 45, 150) or Color3.fromRGB(32, 32, 44)
			btn.TextColor3 = (i == index) and Color3.new(1, 1, 1) or Color3.fromRGB(170, 170, 180)
			pages[i].Visible = (i == index)
		end
	end)

	if index == 1 then
		TabButton.BackgroundColor3 = Color3.fromRGB(80, 45, 150)
		TabButton.TextColor3 = Color3.new(1, 1, 1)
		Page.Visible = true
	end
	return Page
end

