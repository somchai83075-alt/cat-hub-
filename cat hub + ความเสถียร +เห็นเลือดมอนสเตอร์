-- NPC ESP (มอนสเตอร์ขอบสีแดงสด)
local npcRecords = {}

local function removeNPC(model)
	if npcRecords[model] then
		if npcRecords[model].hl then npcRecords[model].hl:Destroy() end
		if npcRecords[model].bg then npcRecords[model].bg:Destroy() end
		npcRecords[model] = nil
	end
end

local function addNPC(model)
	if not model or not model:IsA("Model") or npcRecords[model] then return end
	if Players:GetPlayerFromCharacter(model) then return end

	local hum = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head") or model.PrimaryPart
	if not hum or not root or hum.Health <= 0 then return end

	local hl = Instance.new("Highlight")
	hl.Name = "NPC_HL"
	hl.FillColor = Color3.fromRGB(255, 30, 30)
	hl.OutlineColor = Color3.fromRGB(255, 255, 255)
	hl.FillTransparency = 0.5
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Adornee = model
	hl.Parent = Gui

	local bg = Instance.new("BillboardGui")
	bg.Name = "NPC_UI"
	bg.Size = UDim2.fromOffset(160, 40)
	bg.StudsOffset = Vector3.new(0, 3, 0)
	bg.AlwaysOnTop = true
	bg.Adornee = root
	bg.Parent = Gui

	local label = Instance.new("TextLabel", bg)
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.fromRGB(255, 100, 100)
	label.TextStrokeTransparency = 0.2
	label.Font = Enum.Font.GothamBold
	label.TextSize = 11

	npcRecords[model] = { hl = hl, bg = bg, label = label, hum = hum, root = root }
end

AddBtn(TabVisual, "ESP NPC (มอนสเตอร์/ตัวละคร): ปิด", function(btn)
	State.ESP_NPC = not State.ESP_NPC
	btn.Text = State.ESP_NPC and "ESP NPC (มอนสเตอร์/ตัวละคร): เปิด" or "ESP NPC (มอนสเตอร์/ตัวละคร): ปิด"
	btn.BackgroundColor3 = State.ESP_NPC and Color3.fromRGB(25, 130, 190) or Color3.fromRGB(35, 35, 48)
	
	if not State.ESP_NPC then
		for m, _ in pairs(npcRecords) do removeNPC(m) end
	end
end)

RootCleanup:Add(RunService.RenderStepped:Connect(function()
	if not State.ESP_NPC then return end
	local myRoot = Root()
	local myPos = myRoot and myRoot.Position or Vector3.zero

	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
			addNPC(obj)
		end
	end

	for model, rec in pairs(npcRecords) do
		if not model or not model.Parent or rec.hum.Health <= 0 then
			removeNPC(model)
		else
			local dist = (myPos - rec.root.Position).Magnitude
			rec.label.Text = string.format("👹 %s\n❤️ %d/%d | 📏 %dm", model.Name, math.floor(rec.hum.Health), math.floor(rec.hum.MaxHealth), math.floor(dist))
		end
	end
end))

