						tp.Font = Enum.Font.GothamBold
						tp.TextSize = 10
						tp.Text = "วาร์ป"
						Instance.new("UICorner", tp).CornerRadius = UDim.new(0, 4)
						tp.MouseButton1Click:Connect(function() SafeTP(p) end)
					end
				end
			end
		end)
