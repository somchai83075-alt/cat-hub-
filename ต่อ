-- ==================== Item / Container Deep Scan System ====================
local itemRecords = {}

local function removeItemESP(obj)
	local record = itemRecords[obj]
	if not record then return end
	if record.cleanup then record.cleanup:Destroy() end
	itemRecords[obj] = nil
end

local function addItemESP(obj)
	if not obj or not obj.Parent or itemRecords[obj] then return end
	local primaryPart = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)) or (obj:IsA("BasePart") and obj)
	if not primaryPart then return end

	local itemCleanup = Cleanup.new()
	RootCleanup:Add(itemCleanup)

	local highlight = Instance.new("Highlight")
	highlight.Name = "ItemESP_Highlight"
	highlight.Adornee = obj
	highlight.FillColor = Color3.fromRGB(255, 215, 0)
	highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	highlight.FillTransparency = 0.5
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = Gui
	itemCleanup:Add(highlight)

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "ItemESP_Billboard"
	billboard.Size = UDim2.new(0, 120, 0, 30)
	billboard.StudsOffset = Vector3.new(0, 1.5, 0)
	billboard.AlwaysOnTop = true
	billboard.Adornee = primaryPart
	billboard.Parent = Gui
	itemCleanup:Add(billboard)

	local txtLabel = Instance.new("TextLabel", billboard)
	txtLabel.Size = UDim2.new(1, 0, 1, 0)
	txtLabel.BackgroundTransparency = 1
	txtLabel.TextColor3 = Color3.fromRGB(255, 255, 100)
	txtLabel.TextStrokeTransparency = 0
	txtLabel.Font = Enum.Font.GothamBold
	txtLabel.TextSize = 10

	itemCleanup:Add(RunService.RenderStepped:Connect(function()
		if not State.ESP_Item or not obj.Parent then
			billboard.Enabled = false
			highlight.Enabled = false
			return
		end
		billboard.Enabled = true
		highlight.Enabled = true
		local myRoot = Root()
		local dist = myRoot and math.floor((myRoot.Position - primaryPart.Position).Magnitude) or 0
		txtLabel.Text = string.format("📦 %s (%dm)", obj.Name, dist)
	end))

	itemRecords[obj] = { cleanup = itemCleanup }
end

