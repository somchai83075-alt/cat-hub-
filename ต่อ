						lbl.Font = Enum.Font.Gotham
						lbl.TextSize = 10
						lbl.Text = string.format("👤 %s\n@%s", dName, uName)
						lbl.TextXAlignment = Enum.TextXAlignment.Left

						local tp = Instance.new("TextButton", item)
						tp.Size = UDim2.new(0, 42, 0, 24)
						tp.Position = UDim2.new(1, -46, 0, 6)
						tp.BackgroundColor3 = Color3.fromRGB(40, 140, 70)
