	RootCleanup:Add(SearchBox:GetPropertyChangedSignal("Text"):Connect(RefreshList))
	RootCleanup:Add(Players.PlayerAdded:Connect(RefreshList))
	RootCleanup:Add(Players.PlayerRemoving:Connect(RefreshList))
	RefreshList()
end)

