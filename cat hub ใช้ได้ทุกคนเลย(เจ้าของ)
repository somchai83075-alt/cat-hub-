-- --- [NPC ESP (ขอบแดงสด + เลือด + ทะลุกำแพง)] ---
local npcRecords = {}

local function getRoot(model)
	return model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
end

local function isPlayerCharacter(model)
	for _, player in ipairs(Players:GetPlayers()) do
		if player.Character == model then return true end
	end
	return false
end

local function removeNPC(model)
	local record = npcRecords[model]
	if not record then return end
	if record.cleanup then record.cleanup:Destroy() end
	npcRecords[model] = nil
end

local function addNPC(model)
	if not model or not model:IsA("Model") or not model:IsDescendantOf(Workspace) then return end
	if isPlayerCharacter(model) or npcRecords[model] then return end

	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = getRoot(model)
	if not humanoid or not root or humanoid.Health <= 0 then return end

	local npcCleanup = Cleanup.new()
	RootCleanup:Add(npcCleanup)

	local highlight = Instance.new("Highlight")
	highlight.Name = "NPCESP_Highlight"
	highlight.Adornee = model
	highlight.FillColor = Color3.fromRGB(255, 80, 80)
	highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	highlight.FillTransparency = 0.55
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = Gui
	npcCleanup:Add(highlight)

	local billboard = Instance.new("
