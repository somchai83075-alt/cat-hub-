-- ระบบล่องหน Real FE (ซ่อนตัวใต้โลก แต่ล็อกมุมกล้องให้อยู่บนพื้นปกติ)
local invisConn = nil
AddBtn(TabMain, "ล่องหน (คนอื่นไม่เห็น): ปิด", function(btn)
	State.INV = not State.INV
	btn.Text = State.INV and "ล่องหน (คนอื่นไม่เห็น): เปิด" or "ล่องหน (คนอื่นไม่เห็น): ปิด"
	btn.BackgroundColor3 = State.INV and Color3.fromRGB(25, 130, 190) or Color3.fromRGB(35, 35, 48)
	
	local char = LocalPlayer.Character
	local root = Root()
	local hum = Hum()
	if not char or not root or not hum then return end

	if State.INV then
		pcall(function()
			for _, v in ipairs(char:GetDescendants()) do
				if v:IsA("BasePart") or v:IsA("Decal") then v.Transparency = 0.5
				elseif v:IsA("Accessory") then local h = v:FindFirstChild("Handle") if h then h.Transparency = 0.5 end end
			end
		end)

		invisConn = RunService.Heartbeat:Connect(function()
			if not State.INV or not char.Parent or hum.Health <= 0 then
				if invisConn then invisConn:Disconnect() end
				return
			end
			pcall(function()
				local camCF = Camera.CFrame
				local oldCF = root.CFrame
				root.CFrame = oldCF * CFrame.new(0, -10000, 0)
				RunService.RenderStepped:Wait()
				root.CFrame = oldCF
				Camera.CFrame = camCF
			end)
		end)
	else
		if invisConn then invisConn:Disconnect() invisConn = nil end
		pcall(function()
			for _, v in ipairs(char:GetDescendants()) do
				if v:IsA("BasePart") or v:IsA("Decal") then v.Transparency = 0
				elseif v:IsA("Accessory") then local h = v:FindFirstChild("Handle") if h then h.Transparency = 0 end end
			end
		end)
	end
end)

