local function removeESP(plr)
	pcall(function()
		if EspDrawings[plr] then
			if EspDrawings[plr].Billboard then EspDrawings[plr].Billboard:Destroy() end
			if EspDrawings[plr].Highlight then EspDrawings[plr].Highlight:Destroy() end
			EspDrawings[plr] = nil
		end
	end)
end

local function addESP(plr)
	if plr == LocalPlayer then return end
	pcall(function()
		local function setup(char)
			removeESP(plr)
			local head = char:WaitForChild("Head", 3)
			local hum = char:WaitForChild("Humanoid", 3)
			local root = char:WaitForChild("HumanoidRootPart", 3)
			if not head or not hum or not root then return end

			local hl = Instance.new("Highlight")
			hl.Name = "CatESP_HL"
			hl.FillColor = Color3.fromRGB(0, 170, 255)
			hl.OutlineColor = Color3.fromRGB(255, 255, 255)
			hl.FillTransparency = 0.5
			hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			hl.Parent = char

			local bg = Instance.new("BillboardGui")
			bg.Name = "CatESP_UI"
			bg.Size = UDim2.new(0, 150, 0, 50)
			bg.StudsOffset = Vector3.new(0, 2.5, 0)
			bg.AlwaysOnTop = true
			bg.Adornee = head
			bg.Parent = char

			local txtLabel = Instance.new("TextLabel", bg)
			txtLabel.Size = UDim2.new(1, 0, 1, 0)
			txtLabel.BackgroundTransparency = 1
			txtLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
			txtLabel.TextStrokeTransparency = 0
			txtLabel.Font = Enum.Font.GothamBold
			txtLabel.TextSize = 11

			EspDrawings[plr] = { Billboard = bg, Highlight = hl }

			local conn
			conn = RunService.RenderStepped:Connect(function()
				if not State.ESP or not char.Parent or hum.Health <= 0 then
					bg.Enabled = false
					hl.Enabled = false
					if not State.ESP then conn:Disconnect() end
					return
				end
				bg.Enabled = true
				hl.Enabled = true
				local myRoot = Root()
				local dist = myRoot and math.floor((myRoot.Position - root.Position).Magnitude) or 0
				txtLabel.Text = string.format("%s\n❤️ %d/%d | 📏 %dm", plr.DisplayName, math.floor(hum.Health), math.floor(hum.MaxHealth), dist)
			end)
		end
		if plr.Character then setup(plr.Character) end
		plr.CharacterAdded:Connect(setup)
		plr.CharacterRemoving:Connect(function() removeESP(plr) end)
	end)
end

AddBtn(TabVisual, "ESP (ชื่อ/เลือด): ปิด", function(btn)
