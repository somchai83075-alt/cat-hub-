local function Dis(name)
	if Conn[name] then
		pcall(function() Conn[name]:Disconnect() end)
		Conn[name] = nil
	end
end

local function Hum()
	local ok, h = pcall(function() return LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") end)
	return ok and h or nil
end

local function Root()
	local ok, r = pcall(function() return LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") end)
	return ok and r or nil
end

