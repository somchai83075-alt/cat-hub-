-- ==================== 5. ผู้เล่น / วาร์ป (ระบบ Safe Teleport ป้องกันดีด) ====================
pcall(function()
	local SearchBox = AddInput(TabPlayer, "🔍 ค้นหาชื่อผู้เล่น...", function() end)
	local listHolder = Instance.new("ScrollingFrame", TabPlayer)
	listHolder.Size = UDim2.new(1, -4, 0, 140)
	listHolder.BackgroundTransparency = 1
	listHolder.CanvasSize = UDim2.new(0, 0, 0, 0)
	listHolder.ScrollBarThickness = 2

	local listLayout = Instance.new("UIListLayout", listHolder)
	listLayout.Padding = UDim.new(0, 4)
	listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		listHolder.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 10)
	end)

	local function SafeTP(targetPlr)
		pcall(function()
			if not targetPlr or not targetPlr.Character then return end
			local targetRoot = targetPlr.Character:FindFirstChild("HumanoidRootPart")
			local myRoot = Root()
			local hum = Hum()
			
			if targetRoot and myRoot then
				myRoot.AssemblyLinearVelocity = Vector3.zero
				myRoot.AssemblyAngularVelocity = Vector3.zero
				myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 3, 3)
				if hum then hum:ChangeState(Enum.HumanoidStateType.GettingUp) end
			end
		end)
	end

	local function RefreshList()
		pcall(function()
			for _, c in ipairs(listHolder:GetChildren()) do
				if c:IsA("Frame") then c:Destroy() end
			end
			local filter = string.lower(SearchBox.Text)
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= LocalPlayer then
					local dName = p.DisplayName
					local uName = p.Name
					if filter == "" or string.find(string.lower(dName .. " " .. uName), filter, 1, true) then
						local item = Instance.new("Frame", listHolder)
						item.Size = UDim2.new(1, 0, 0, 36)
						item.BackgroundColor3 = Color3.fromRGB(32, 32, 42)
						Instance.new("UICorner", item).CornerRadius = UDim.new(0, 5)

						local lbl = Instance.new("TextLabel", item)
						lbl.Size = UDim2.new(1, -50, 1, 0)
						lbl.Position = UDim2.new(0, 6, 0, 0)
						lbl.BackgroundTransparency = 1
						lbl.TextColor3 = Color3.new(1, 1, 1)
						lbl.Font = Enum.Font.Gotham
						lbl.TextSize = 10
						lbl.Text = string.format("👤 %s\n@%s", dName, uName)
						lbl.TextXAlignment = Enum.TextXAlignment.Left

						local tp = Instance.new("TextButton", item)
						tp.Size = UDim2.new(0, 42, 0, 24)
						tp.Position = UDim2.new(1, -46, 0, 6)
						tp.BackgroundColor3 = Color3.fromRGB(40, 140, 70)
						tp.TextColor3 = Color3.new(1, 1, 1)
						tp.Font = Enum.Font.GothamBold
						tp.TextSize = 10
						tp.Text = "วาร์ป"
						Instance.new("UICorner", tp).CornerRadius = UDim.new(0, 4)
						tp.MouseButton1Click:Connect(function() SafeTP(p) end)
					end
				end
			end
		end)
	end

	SearchBox:GetPropertyChangedSignal("Text"):Connect(RefreshList)
	Players.PlayerAdded:Connect(RefreshList)
	Players.PlayerRemoving:Connect(RefreshList)
	RefreshList()
end)

